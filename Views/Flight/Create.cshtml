@model Flight

@{
    ViewData["Title"] = "Добавление рейса";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-body p-4">
            <h2 class="mb-4">Добавление рейса</h2>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Number" class="form-label">Номер рейса</label>
                    <input asp-for="Number" class="form-control" />
                    <span asp-validation-for="Number" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="From" class="form-label">Откуда</label>
                    <input asp-for="From" class="form-control" />
                    <span asp-validation-for="From" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="To" class="form-label">Куда</label>
                    <input asp-for="To" class="form-control" />
                    <span asp-validation-for="To" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Цена</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label">Есть места</label>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}